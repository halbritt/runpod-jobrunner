{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runpod-jobrunner.local/schemas/artifact-manifest-1.json",
  "title": "runpod-jobrunner artifact-manifest/1",
  "type": "object",
  "required": ["protocol", "files"],
  "properties": {
    "protocol": {"const": "artifact-manifest/1"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/safe-relative-path"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safe-relative-path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?=.+[^/])[^\\u0000]+$"
    }
  }
}
