{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runpod-jobrunner.local/schemas/job-spec-1.json",
  "title": "runpod-jobrunner job-spec/1",
  "type": "object",
  "required": [
    "protocol",
    "name",
    "bundle_hash",
    "image",
    "runner",
    "resources",
    "inputs",
    "phases",
    "limits",
    "heartbeat_interval_seconds",
    "termination_grace_seconds"
  ],
  "properties": {
    "protocol": {"const": "job-spec/1"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "runner": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": ["manifest"],
      "properties": {
        "manifest": {"const": "input-manifest.json"}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": ["verify", "preflight", "train", "evaluate", "package"],
      "properties": {
        "verify": {"$ref": "#/$defs/phase"},
        "preflight": {"$ref": "#/$defs/phase"},
        "train": {"$ref": "#/$defs/phase"},
        "evaluate": {"$ref": "#/$defs/phase"},
        "package": {"$ref": "#/$defs/phase"}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_elapsed_seconds", "max_cost_usd", "usd_per_hour"],
      "properties": {
        "max_elapsed_seconds": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"$ref": "#/$defs/positive-money"},
        "usd_per_hour": {"$ref": "#/$defs/positive-money"}
      },
      "additionalProperties": false
    },
    "heartbeat_interval_seconds": {"type": "integer", "minimum": 1},
    "termination_grace_seconds": {"type": "integer", "minimum": 0},
    "resources": {
      "type": "object",
      "required": ["gpu_types", "gpu_count", "storage"],
      "properties": {
        "gpu_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "gpu_count": {"type": "integer", "minimum": 1},
        "storage": {
          "type": "object",
          "required": ["encrypted", "mount", "required_gb"],
          "properties": {
            "encrypted": {"const": true},
            "mount": {
              "type": "string",
              "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "required_gb": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "artifacts": {"type": "object"},
    "lifecycle": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "positive-money": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$"
    },
    "phase": {
      "type": "object",
      "required": ["enabled", "argv", "timeout_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "argv": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {"properties": {"argv": {"minItems": 1}}}
        }
      ]
    }
  }
}
